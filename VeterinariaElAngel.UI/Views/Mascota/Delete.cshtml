@model VeterinariaElAngel.EN.Mascota

@{
    ViewData["Title"] = "Eliminar Registro";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-danger shadow">
                <div class="card-body text-center py-4">
                    <i class="fas fa-dog fa-3x text-danger mb-3"></i>
                    <h4 class="text-danger">¿Eliminar Paciente?</h4>
                    <p class="mb-4">Está a punto de borrar a: <strong>@Model.Nombre</strong></p>
                    
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdMascota" />
                        <div class="btn-group w-100">
                            <button type="submit" class="btn btn-danger py-2">Sí, Eliminar</button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>