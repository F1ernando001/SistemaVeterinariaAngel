@model VeterinariaElAngel.EN.Mascota

@{
    ViewData["Title"] = "Nuevo Paciente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Registrar Mascota</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label font-weight-bold">Nombre de la Mascota</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Estado" id="estadoSwitch" checked>
                                <label class="form-check-label" for="estadoSwitch">Paciente Activo</label>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">Guardar Paciente</button>
                                <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>