@model VeterinariaElAngel.EN.Especie

@{
    ViewData["Title"] = "Eliminar Especie";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-danger shadow">
                <div class="card-body text-center">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                    <h4>¿Eliminar @Model.NombreEspecie?</h4>
                    <p class="text-muted">Si borras esta especie, podrías afectar los registros de mascotas asociados.</p>
                    
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="IdEspecie" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>