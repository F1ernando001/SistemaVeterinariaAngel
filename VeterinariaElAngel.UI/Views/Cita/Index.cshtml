@model IEnumerable<VeterinariaElAngel.EN.Cita>

@{
    ViewData["Title"] = "Listado de Citas";
}

<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col-md-8">
            <h2 class="text-primary"><i class="fas fa-calendar-check"></i> Control de Citas - El Ángel</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus"></i> Agendar Cita
            </a>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Fecha de la Cita</th>
                            <th>Hora</th>
                            <th>Registro en Sistema</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.IdCita</td>
                                <td>
                                    <span class="fw-bold">@item.FechaCita.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        <i class="far fa-clock"></i> @item.HoraCita.ToString("hh:mm tt")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.IdCita" class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.IdCita" class="btn btn-sm btn-outline-info" title="Ver Detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdCita" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-light text-center py-4">
                    <i class="fas fa-info-circle fa-2x text-muted mb-2"></i>
                    <p class="mb-0">No se encontraron citas registradas.</p>
                </div>
            }
        </div>
    </div>
</div>