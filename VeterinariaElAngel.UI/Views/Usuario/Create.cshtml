@model VeterinariaElAngel.EN.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0">Registro de Nuevo Personal</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label fw-bold"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label fw-bold"></label>
                                <input asp-for="Apellido" class="form-control" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdRol" class="form-label fw-bold"></label>
                                <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol">
                                    <option value="">-- Seleccione un Rol --</option>
                                </select>
                                <span asp-validation-for="IdRol" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-bold"></label>
                                <input asp-for="Correo" class="form-control" type="email" />
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-bold"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Telefono" class="form-label fw-bold"></label>
                                <input asp-for="Telefono" class="form-control" maxlength="8" />
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="DUI" class="form-label fw-bold"></label>
                                <input asp-for="DUI" class="form-control" placeholder="00000000-0" />
                                <span asp-validation-for="DUI" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dirección" class="form-label fw-bold">Dirección de Residencia</label>
                            <textarea asp-for="Dirección" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Dirección" class="text-danger"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Estado" id="usrEstado" checked>
                                <label class="form-check-label" for="usrEstado">Habilitar cuenta inmediatamente</label>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">Registrar Usuario</button>
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>