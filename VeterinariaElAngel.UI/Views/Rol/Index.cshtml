@model IEnumerable<VeterinariaElAngel.EN.Rol>

@{
    ViewData["Title"] = "Gestión de Roles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="fas fa-user-shield"></i> Roles del Sistema</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus"></i> Nuevo Rol
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 10%">ID</th>
                        <th style="width: 40%">Tipo de Rol</th>
                        <th style="width: 25%">Estado</th>
                        <th class="text-center" style="width: 25%">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdRol</td>
                            <td class="fw-bold">@item.TipoRol</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge rounded-pill bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>